flowchart TD
    subgraph Edge [" 1. Edge & Ingress Tier "]
        Client["Clients / External Consumers"]
        R53["Amazon Route 53"]
        WAF["AWS WAF"]
        ACM["AWS Certificate Manager (ACM)"]
        ALB["Multi-AZ Application Load Balancer"]

        Client -->|HTTPS :443| R53
        R53 --> WAF
        WAF --> ALB
        ACM -.->|TLS Certificate| ALB
    end

    subgraph VPC [" 2. AWS VPC (Multi-AZ Private Subnets) "]
        direction TB

        subgraph EKS [" Application Tier (Amazon EKS) "]
            direction TB
            Pods["Birthday API Pods"]
            Reloader["Stakater Reloader"]

            Reloader -.->|Rollout on Secret Change| Pods
        end

        subgraph Persistence [" Persistence Tier "]
            Proxy["RDS Proxy / Connection Pooler"]
            DB[("Amazon Aurora PostgreSQL Multi-AZ")]
            Proxy -->|Multiplexed Connections :5432| DB
        end

        subgraph SecurityControls [" Workload Identity & Secrets "]
            SecMgr["AWS Secrets Manager"]
            ESO["External Secrets Operator"]
            K8sSecret["Kubernetes Secret"]
            IRSA["EKS Pod Identity / IRSA"]

            SecMgr -->|Sync Credentials| ESO
            ESO -->|Create / Update| K8sSecret
            K8sSecret -.->|Watch Secret Change| Reloader
        end
    end

    ALB -->|"Direct Pod Ingress :8000 (VPC CNI IP Target)"| Pods
    Pods -->|App Connection Pool| Proxy
    IRSA -->|Project STS Token| Pods

    subgraph Operations [" 3. Operational & Telemetry Planes "]
        direction LR
        Obs["OpenTelemetry / Prometheus & CloudWatch"]
        GitOps["ArgoCD"]
    end

    Pods -.->|Metrics & Traces| Obs
    DB -.->|Engine Metrics| Obs
    GitOps -.->|Reconcile Manifests| Pods
